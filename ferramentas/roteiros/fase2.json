    "js": "(() => { const C = jogo.scene.getScene('CenaPrincipal'); window.C = C; window.irAte = (coluna, linha, lado) => { const lados = { cima: [0, 1], esquerda: [1, 0], direita: [-1, 0], baixo: [0, -1] }; const ordem = lado ? [lado] : ['cima', 'esquerda', 'direita', 'baixo']; for (const olhar of ordem) { const [dx, dy] = lados[olhar]; const pc = coluna + dx, pl = linha + dy; if (!lado && !C.mundo.mapa.livre(pc, pl)) continue; C.jogador.teleportar(pc, pl, olhar); return [pc, pl, olhar]; } return null; }; window.naSala = (id, coluna, linha, lado) => { const k = C.interiores.cantos.get(id); return irAte(k.coluna + 1 + coluna, k.linha + 1 + linha, lado); }; window.portaDaSala = (id) => { const p = C.interiores.portaDe(id); return irAte(p.coluna, p.linha, 'baixo'); }; window.ultimoAviso = () => C.mundo.avisos.linhas.map((l) => l.texto.text).join(' | '); return 'ok'; })()"
