  {
    "rotulo": "preparar atalhos do teste",
    "js": "(() => { window.cena = () => jogo.scene.getScene('CenaPrincipal'); window.irAte = (coluna, linha, lado) => { const C = cena(); const lados = { cima: [0, 1], esquerda: [1, 0], direita: [-1, 0], baixo: [0, -1] }; const [dx, dy] = lados[lado]; C.jogador.teleportar(coluna + dx, linha + dy, lado); return 'ok'; }; window.ate = (h) => { const r = cena().mundo.relogio; r.avancar(((h - r.hora + 24) % 24) * 12000); return r.horario; }; window.escolher = (trecho) => { const m = cena().mundo.menu; const i = m.opcoes.findIndex((o) => o.texto.includes(trecho)); m.selecionada = i; return i; }; return 'ok'; })()"
